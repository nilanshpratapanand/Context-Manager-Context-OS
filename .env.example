# ===========================================================================
#  ContextOS - free LLM providers
#  Copy this file to ".env" in the same folder, then paste in your keys.
#  You need at least TWO working providers for a real handoff demo.
#  Check what works at any time:   RUN.bat  ->  T
#  See which models a key allows:  RUN.bat  ->  M
# ===========================================================================

# ---------------------------------------------------------------------------
# TIER 1 - free forever, no credit card. Start with these.
# ---------------------------------------------------------------------------

# Google AI Studio (Gemini) - the most dependable free tier: ~15 req/min,
# ~1500 req/day on Flash. No card.
# GET A KEY: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Groq - fastest free inference, ~30 req/min. No card.
# GET A KEY: https://console.groq.com/keys
# MODELS:    https://console.groq.com/docs/models
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile     # Qwen on Groq is preview-only

# OpenRouter - ONE key, many models. Any model ending in ":free" costs nothing.
# Best single addition: if one upstream dies, another ":free" model still works.
# GET A KEY: https://openrouter.ai/keys
# MODELS:    https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# NVIDIA NIM - free credits, OpenAI-compatible, no card.
# GET A KEY: https://build.nvidia.com/  (sign in, open any model, "Get API Key")
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Cloudflare Workers AI - 10,000 neurons/day free. You already have a
# Cloudflare account for your Pages sites, so this is a quick win.
# API TOKEN:  https://dash.cloudflare.com/profile/api-tokens
#             (template: "Workers AI (Read)" or a custom token with Workers AI)
# ACCOUNT ID: on your Cloudflare dashboard URL, dash.cloudflare.com/<account_id>
# MODELS:     https://developers.cloudflare.com/workers-ai/models/
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Mistral AI - generous monthly allowance, but the free tier is often busy
# (HTTP 429 just means "come back later", not a bad key).
# GET A KEY: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# Zhipu AI (GLM) - the "-flash" models are free.
# GET A KEY: https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.5-flash

# Cohere - free tier is NON-COMMERCIAL only. Fine for a college project.
# GET A KEY: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
# COHERE_MODEL=command-r-plus

# ---------------------------------------------------------------------------
# TIER 2 - needs a card, or bills from the first call. Only if you want them.
# ---------------------------------------------------------------------------

# Cerebras - very fast. Reports differ on whether the free tier still needs a
# card; your existing key authenticates, so yours works. Check models with "M".
# GET A KEY: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b

# Together AI - no longer has a free tier; it bills before use.
# GET A KEY: https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# Anthropic - paid, kept last in the cascade.
# GET A KEY: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------------------------------------------------------------------------
# TIER 3 - your own laptop. No key, no quota, no internet needed.
# ---------------------------------------------------------------------------
# Install Ollama, then:  ollama pull llama3.1:8b
# DOWNLOAD: https://ollama.com/download
# Set the value below to anything (it is a switch, not a secret).
# This is the one provider that can never rate-limit you mid-demo.
OLLAMA_API_KEY=
# OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Cascade order - tried left to right. Remove a name to skip that provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER_ORDER=gemini,groq,openrouter,nvidia,cloudflare,mistral,zhipu,cohere,cerebras,ollama

# LLM_DEBUG=1
# LLM_TIMEOUT=30
